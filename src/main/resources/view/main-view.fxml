<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.financetracker.controllers.MainWindowController">
    <left>
        <VBox spacing="10" style="-fx-background-color: #F6F8FA;" prefWidth="200" alignment="TOP_CENTER">
            <Label text="FinBank" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            <Separator />
            <VBox spacing="5" alignment="TOP_LEFT">
                <Button text="Dashboard" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
                <Button text="Transactions" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
                <Button text="Card Center" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
                <Button text="E-Wallet Center" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
                <Button text="Reports" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
            </VBox>
            <Separator />
            <VBox spacing="5" alignment="BOTTOM_LEFT">
                <Button text="Settings" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
                <Button text="Help Center" style="-fx-background-color: transparent; -fx-text-fill: #333;" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox spacing="10" padding="10" style="-fx-background-color: #FFFFFF;">
            <Label text="Welcome to FinBank" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <ImageView fitWidth="30" fitHeight="30" />
            <ImageView fitWidth="30" fitHeight="30" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" padding="15">
            <HBox spacing="15">
                <VBox spacing="10" padding="15" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" prefWidth="400">
                    <Label text="Debit Card Account" style="-fx-font-weight: bold;" />
                    <Pane style="-fx-background-color: #E5E9F2; -fx-border-radius: 10;" prefHeight="100">
                        <Label text="Card Details Here" layoutX="10" layoutY="10" />
                    </Pane>
                    <Button text="Add Debit Card" style="-fx-background-color: #00A7E1; -fx-text-fill: #FFF; -fx-border-radius: 5;" />
                </VBox>

                <VBox spacing="10" padding="15" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" prefWidth="200">
                    <Label text="Your Total Balance" style="-fx-font-weight: bold;" />
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold;" />
                </VBox>
            </HBox>

            <VBox spacing="10" padding="15" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 5;">
                <Label text="Recent Transactions" style="-fx-font-weight: bold;" />
                <TableView>
                    <columns>
                        <TableColumn text="Description" />
                        <TableColumn text="Amount" />
                        <TableColumn text="Date" />
                    </columns>
                </TableView>
            </VBox>

            <HBox spacing="15">
                <VBox spacing="10" padding="15" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" prefWidth="200">
                    <Label text="Expenses Instead" style="-fx-font-weight: bold;" />
                    <ProgressIndicator progress="0.85" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>